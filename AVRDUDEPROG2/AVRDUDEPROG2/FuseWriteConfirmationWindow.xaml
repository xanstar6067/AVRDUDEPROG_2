<Window x:Class="AVRDUDEPROG2.FuseWriteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение записи fuse" Width="640" Height="510" MinWidth="560" MinHeight="430"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Проверьте каждое изменение" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="DeviceText" Style="{StaticResource MutedText}" Margin="0,3,0,8" />
            <Border Background="#FDE7E9" BorderBrush="#D13438" BorderThickness="1" CornerRadius="2" Padding="8">
                <TextBlock x:Name="RiskText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ListBox x:Name="ChangeList" Grid.Row="1" Margin="0,9" Background="{StaticResource SurfaceBrush}"
                 BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MemoryName}" Style="{StaticResource MutedText}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock>
                                    <Run Text="{Binding OldHex, Mode=OneWay}" /><Run Text="  →  " Foreground="{StaticResource AccentBrush}" /><Run Text="{Binding NewHex, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ChangedBits}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="ОПАСНО" Foreground="{StaticResource DangerBrush}" FontSize="10"
                                       FontWeight="Bold" Visibility="{Binding DangerVisibility}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Для подтверждения введите ЗАПИСАТЬ" FontWeight="SemiBold" />
            <TextBox x:Name="ConfirmationBox" Margin="0,4,0,8" TextChanged="ConfirmationBox_TextChanged" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True" Margin="0,0,6,0" />
            <Button x:Name="ConfirmButton" Content="Записать fuse-биты" Style="{StaticResource DangerButton}"
                    IsEnabled="False" Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
